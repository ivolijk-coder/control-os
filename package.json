{
  "name": "control-os",
  "private": true,
  "version": "0.1.0",
  "description": "CONTROL OS — Operational Intelligence Platform. Monorepo raiz.",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/web",
    "dev:web": "turbo run dev --filter=./apps/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "build": "turbo run build --filter=./apps/web",
    "build:web": "turbo run build --filter=./apps/web",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=./apps/web",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @control-os/web test",
    "test:unit": "pnpm --filter @control-os/web test:unit",
    "test:integration": "pnpm --filter @control-os/web test:integration",
    "test:documents": "pnpm --filter @control-os/web test:documents",
    "test:coverage": "pnpm --filter @control-os/web test:coverage",
    "db:up": "docker compose -f database/docker-compose.yml up -d"
  },
  "devDependencies": {
    "turbo": "^2.1.2"
  },
  "engines": {
    "node": "22.x"
  }
}
