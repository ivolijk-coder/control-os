{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@control-os/ui": ["../../packages/ui/src"],
      "@control-os/ui/*": ["../../packages/ui/src/*"],
      "@control-os/types": ["../../packages/types/src"],
      "@control-os/types/*": ["../../packages/types/src/*"],
      "@control-os/hooks": ["../../packages/hooks/src"],
      "@control-os/hooks/*": ["../../packages/hooks/src/*"],
      "@control-os/utils": ["../../packages/utils/src"],
      "@control-os/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
