// CONTROL OS — Fase 6: Persistência real (Prisma + PostgreSQL).
//
// "O Module Service nunca deverá conversar diretamente com Prisma." — este
// schema só é importado por `services/repositories/finance/prisma-finance.repository.ts`
// (a ÚNICA classe de todo o CONTROL OS que conhece `@prisma/client`).
//
// Banco compartilhado com `apps/api` (mesmo Postgres já provisionado por
// `database/docker-compose.yml`, banco `control_os`) — NÃO um banco novo.
// `apps/api` (SQLAlchemy + Alembic) já é dono da tabela `users`; todo model
// deste schema usa `@@map`/`@map` com prefixo `finance_` para nunca colidir
// com nada que o Alembic gerencie, mesmo os dois convivendo no mesmo banco
// físico. `userId` aqui é só um UUID solto (sem FK cross-schema — Prisma e
// Alembic são sistemas de migration independentes; uma FK de verdade exigiria
// os dois lados compartilharem um migration tool só, fora de escopo desta
// fase) — mesmo formato (`Uuid`) que `users.id` em `apps/api`, por
// consistência, não por integridade referencial garantida pelo banco.
//
// Convenção de nomes: colunas em snake_case (`@map`), tabelas em snake_case
// prefixadas (`@@map`) — mesmo estilo de `database/init.sql` (`created_at`,
// `hashed_password`...), para o schema inteiro do banco `control_os` seguir
// uma convenção só, não duas, mesmo vindo de dois ORMs diferentes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tipo de uma transação financeira — "Transaction... Income, Expense" do
/// pedido original: em vez de duas tabelas (`incomes`/`expenses`), uma
/// entidade única (`Transaction`) discriminada por este enum. Mesma
/// unificação que `FinanceEntry` (`@control-os/types`, `type: 'receita' |
/// 'despesa' | 'transferencia'`) já usa no domínio — este enum é só o
/// espelho, em PostgreSQL, do mesmo conceito (nunca um terceiro
/// vocabulário).
///
/// CONTROL OS — Fase 7 (Financeiro completo): `TRANSFER` adicionado —
/// "Transferência entre contas... sem alterar patrimônio total". Uma
/// transferência gera DUAS `Transaction` (uma por conta), ambas
/// `type: TRANSFER` (nunca `INCOME`/`EXPENSE`) — assim `getSummary`
/// (`groupBy type`) já ignora as duas pernas automaticamente, sem nenhum
/// filtro extra: soma só `INCOME`/`EXPENSE`, exatamente o que "não altera
/// o patrimônio total" pede.
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// Direção de uma perna de transferência (`Transaction.transferDirection`)
/// — só preenchido quando `type == TRANSFER`. `OUT`: débito na conta de
/// origem; `IN`: crédito na conta de destino. Usado só para calcular saldo
/// POR CONTA (`getAccountBalance`) — o saldo TOTAL nunca precisa disto,
/// porque ignora `TRANSFER` inteiramente (ver acima).
enum TransferDirection {
  IN
  OUT
}

/// Classificação opcional de uma `Account` (CONTROL OS — Fase 7) — "Carteira,
/// Conta Corrente, Poupança, Nubank, Inter, Caixa, Cartão de Crédito": os
/// nomes de banco (`Account.name`) continuam livres; `kind` é só para
/// agrupamento futuro (Dashboard), nunca usado para decidir comportamento
/// nesta fase.
enum AccountKind {
  CARTEIRA
  CONTA_CORRENTE
  POUPANCA
  CARTAO_CREDITO
  OUTRO
}

/// Entidade única de lançamento financeiro — cobre tanto receitas quanto
/// despesas (`type`). Mapeia para `FinanceEntry` (`@control-os/types`) na
/// borda do repositório (`PrismaFinanceRepository`) — nenhum tipo TS novo
/// duplicando `FinanceEntry` é criado por causa deste model.
model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  /// `Decimal`, não `Float` — dinheiro nunca deveria acumular erro de
  /// ponto flutuante binário. Convertido para `number` (formato de
  /// `FinanceEntry.amount`) na borda do repositório via `.toNumber()`.
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  /// Rótulo livre (mesmo formato de `FinanceEntry.category`, `@control-os/types`)
  /// — o que esta fase de fato usa. Coexiste com `categoryId`/`categoryRef`
  /// abaixo de propósito: "expand-and-contract" — quando `Category` ganhar
  /// CRUD real (fase futura), a migração vira só passar a preencher
  /// `categoryId` também, sem quebrar nada que já lê `category` (string).
  category    String?
  date        DateTime        @default(now()) @db.Timestamptz(3)

  categoryId  String?   @map("category_id") @db.Uuid
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  accountId String?  @map("account_id") @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id])

  /// CONTROL OS — Fase 7: guardava só a intenção ("preparado para
  /// recorrência futura"); agora `FinanceService.createRecurring` de fato
  /// escreve aqui o rótulo de frequência (`FinanceRecurrenceFrequency` —
  /// "mensal"/"semanal"/"anual"). Ainda "sem scheduler": nenhum job lê este
  /// campo para gerar novas `Transaction` automaticamente — só a primeira
  /// ocorrência é criada nesta fase.
  recurrenceRule String? @map("recurrence_rule")

  /// CONTROL OS — Fase 7: liga as DUAS pernas de uma mesma transferência
  /// (uma por conta). `transferDirection` diferencia qual perna é qual —
  /// ver doc do enum `TransferDirection` acima.
  transferGroupId   String?            @map("transfer_group_id") @db.Uuid
  transferDirection TransferDirection? @map("transfer_direction")

  /// CONTROL OS — Fase 7: liga todos os lançamentos de um mesmo
  /// parcelamento (ex.: as 12 parcelas de um notebook) — `installmentNumber`
  /// é 1-based, `installmentTotal` é o mesmo valor em todas as parcelas do
  /// grupo (redundante de propósito: evita um `COUNT` a mais só para saber
  /// "3 de quantas?").
  installmentGroupId String? @map("installment_group_id") @db.Uuid
  installmentNumber  Int?    @map("installment_number")
  installmentTotal   Int?    @map("installment_total")

  attachments Attachment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, type, date])
  @@index([userId, accountId])
  @@index([transferGroupId])
  @@index([installmentGroupId])
  @@map("finance_transactions")
}

/// Categoria de lançamento (ex.: "Mercado", "Salário"). CONTROL OS — Fase 7:
/// `FinanceRepository.createCategory`/`listCategories` usam este model de
/// verdade agora (catálogo de categorias personalizadas do usuário,
/// somado às categorias padrão do sistema — que não são linhas desta
/// tabela, ver `DEFAULT_FINANCE_CATEGORIES`). `Transaction.categoryId`/
/// `categoryRef` continuam SEM uso nesta fase — `FinanceEntry.category`
/// continua sendo uma `String` livre (nenhuma FK obrigatória entre uma
/// transação e seu catálogo de categoria), "expand-and-contract" adiado
/// pra uma fase futura.
model Category {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  name         String
  kind         TransactionType?
  transactions Transaction[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, name])
  @@map("finance_categories")
}

/// Conta financeira (ex.: "Carteira", "Nubank", "Cartão de Crédito").
/// CONTROL OS — Fase 7: sai do status de stub ("preparado, não usado") —
/// `FinanceRepository.createAccount`/`listAccounts`/`getOrCreateDefaultAccount`
/// usam este model de verdade agora. `@@unique([userId, name])`: evita duas
/// contas com o mesmo nome pro mesmo usuário (ex.: duas "Nubank" por engano
/// numa criação repetida via conversa) — seguro adicionar agora porque
/// nenhuma linha real existia antes desta fase (nada grava aqui ainda).
model Account {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  kind         AccountKind   @default(OUTRO)
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, name])
  @@map("finance_accounts")
}

/// Anexo de uma transação (ex.: foto de um recibo) — "preparar para
/// anexos, mesmo que ainda não implementados". `onDelete: Cascade`: um
/// anexo nunca deveria sobreviver à transação que ele documenta.
model Attachment {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("finance_attachments")
}
