// CONTROL OS — Fase 6: Persistência real (Prisma + PostgreSQL).
//
// "O Module Service nunca deverá conversar diretamente com Prisma." — este
// schema só é importado por `services/repositories/finance/prisma-finance.repository.ts`
// (a ÚNICA classe de todo o CONTROL OS que conhece `@prisma/client`).
//
// Banco compartilhado com `apps/api` (mesmo Postgres já provisionado por
// `database/docker-compose.yml`, banco `control_os`) — NÃO um banco novo.
// `apps/api` (SQLAlchemy + Alembic) já é dono da tabela `users`; todo model
// deste schema usa `@@map`/`@map` com prefixo `finance_` para nunca colidir
// com nada que o Alembic gerencie, mesmo os dois convivendo no mesmo banco
// físico. `userId` aqui é só um UUID solto (sem FK cross-schema — Prisma e
// Alembic são sistemas de migration independentes; uma FK de verdade exigiria
// os dois lados compartilharem um migration tool só, fora de escopo desta
// fase) — mesmo formato (`Uuid`) que `users.id` em `apps/api`, por
// consistência, não por integridade referencial garantida pelo banco.
//
// Convenção de nomes: colunas em snake_case (`@map`), tabelas em snake_case
// prefixadas (`@@map`) — mesmo estilo de `database/init.sql` (`created_at`,
// `hashed_password`...), para o schema inteiro do banco `control_os` seguir
// uma convenção só, não duas, mesmo vindo de dois ORMs diferentes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tipo de uma transação financeira — "Transaction... Income, Expense" do
/// pedido original: em vez de duas tabelas (`incomes`/`expenses`), uma
/// entidade única (`Transaction`) discriminada por este enum. Mesma
/// unificação que `FinanceEntry` (`@control-os/types`, `type: 'receita' |
/// 'despesa' | 'transferencia'`) já usa no domínio — este enum é só o
/// espelho, em PostgreSQL, do mesmo conceito (nunca um terceiro
/// vocabulário).
///
/// CONTROL OS — Fase 7 (Financeiro completo): `TRANSFER` adicionado —
/// "Transferência entre contas... sem alterar patrimônio total". Uma
/// transferência gera DUAS `Transaction` (uma por conta), ambas
/// `type: TRANSFER` (nunca `INCOME`/`EXPENSE`) — assim `getSummary`
/// (`groupBy type`) já ignora as duas pernas automaticamente, sem nenhum
/// filtro extra: soma só `INCOME`/`EXPENSE`, exatamente o que "não altera
/// o patrimônio total" pede.
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// Direção de uma perna de transferência (`Transaction.transferDirection`)
/// — só preenchido quando `type == TRANSFER`. `OUT`: débito na conta de
/// origem; `IN`: crédito na conta de destino. Usado só para calcular saldo
/// POR CONTA (`getAccountBalance`) — o saldo TOTAL nunca precisa disto,
/// porque ignora `TRANSFER` inteiramente (ver acima).
enum TransferDirection {
  IN
  OUT
}

/// Classificação opcional de uma `Account` (CONTROL OS — Fase 7) — "Carteira,
/// Conta Corrente, Poupança, Nubank, Inter, Caixa, Cartão de Crédito": os
/// nomes de banco (`Account.name`) continuam livres; `kind` é só para
/// agrupamento futuro (Dashboard), nunca usado para decidir comportamento
/// nesta fase.
enum AccountKind {
  CARTEIRA
  CONTA_CORRENTE
  POUPANCA
  CARTAO_CREDITO
  OUTRO
}

/// Ciclo de vida de uma conta. Uma conta com histórico nunca é apagada: ela
/// pode ser arquivada e restaurada sem perder as movimentações vinculadas.
enum AccountStatus {
  ACTIVE
  ARCHIVED
}

/// Tipo funcional de arquivo guardado pela pessoa. Contratos recebem uma
/// proposta de importação; os demais permanecem documentos privados.
enum StoredDocumentKind {
  GENERAL
  CONTRACT
}

/// Um contrato nunca cria registros financeiros sozinho. A proposta fica
/// pendente até uma confirmação explícita no chat da NOVA ou na tela.
enum DocumentImportProposalStatus {
  PENDING
  READY_FOR_REVIEW
  PROCESSING
  CONFIRMED
  REJECTED
  DISCARDED
  ARCHIVED
  FAILED
  EXPIRED
}

/// O arquivo é mantido em storage privado, independente da OpenAI. Registros
/// LEGACY_OPENAI existem somente para a migração progressiva dos documentos
/// antigos; novos uploads nunca devem usar esse provider como repositório.
enum DocumentStorageProvider {
  S3
  LOCAL_DEVELOPMENT
  LEGACY_OPENAI
}

enum DocumentStorageStatus {
  PENDING_UPLOAD
  AVAILABLE
  UPLOAD_FAILED
  QUARANTINED
  MIGRATION_PENDING
  MIGRATION_FAILED
  ARCHIVED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  NOT_CONFIGURED
}

enum DocumentAnalysisStatus {
  NOT_REQUESTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum DocumentAnalysisJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/// Estágio humano do processamento de um `DocumentAnalysisJob` (Fase F —
/// "NOVA como centro da experiência"). Não inclui um estágio de
/// "verificando segurança": o scan de vírus roda de forma síncrona durante
/// o upload (`persistent-document.service.ts`), ANTES de qualquer job
/// existir — `enqueueDocumentAnalysis` já exige `scanStatus === 'CLEAN'`
/// como pré-condição. Esse rótulo é só do cliente, mostrado enquanto o
/// upload em si está em voo, nunca escrito aqui.
/// `READING_DOCUMENT` é o default: cobre tanto QUEUED quanto o início de
/// PROCESSING (extração de texto), porque o próximo passo real do job,
/// sempre, é ler o documento. `IDENTIFYING_TYPE`/`EXTRACTING_DATA` marcam
/// a mesma chamada única à IA (que classifica e extrai no mesmo request) —
/// dois estágios, uma chamada de rede: nenhum dos dois é fabricado, só
/// podem passar rápido demais pro polling pegar os dois, o que é esperado.
enum DocumentAnalysisProgressStage {
  READING_DOCUMENT
  IDENTIFYING_TYPE
  EXTRACTING_DATA
  PREPARING_RECOMMENDATION
  COMPLETED
  FAILED
}

/// Origem técnica de um lançamento. O saldo de abertura é uma movimentação
/// financeira normal, não um campo solto da conta.
enum TransactionOrigin {
  MANUAL
  ACCOUNT_OPENING_BALANCE
}

/// Ciclo de vida financeiro. Somente lançamentos confirmados participam do
/// saldo realizado; pendentes permanecem disponíveis para projeções futuras.
enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELED
  REVERSED
}

/// Canal que solicitou a operação. O dado é técnico e auditável; nunca vem
/// de um `userId` informado pelo cliente.
enum TransactionSource {
  MANUAL
  NOVA
  WHATSAPP
  API
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

/// A regra recorrente suporta os ciclos que o domínio financeiro prevê. A
/// interface inicial pode expor apenas mensal, mas o banco não precisará ser
/// redesenhado quando semanal, anual ou personalizado forem habilitados.
enum FixedAccountRecurrence {
  MONTHLY
  WEEKLY
  YEARLY
  CUSTOM
}

enum FixedAccountPaymentMethod {
  BANK_ACCOUNT
  CREDIT_CARD
  CASH
  PIX
  BOLETO
  OTHER
}

/// PF, PJ ou outros. É uma classificação da regra e é copiada para cada
/// ocorrência para manter os relatórios históricos consistentes.
enum FixedAccountOrigin {
  PERSONAL
  BUSINESS
  OTHER
}

/// OVERDUE não é persistido: é derivado em leitura quando PENDING e a data de
/// vencimento já passou. Isso evita jobs apenas para trocar estados.
enum FixedAccountOccurrenceStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
}

/// Preparação para conciliação por Open Finance. Nulo significa que ainda não
/// houve tentativa de conciliação; portanto a integração futura não exigirá
/// nova migração estrutural.
enum FixedAccountReconciliationStatus {
  MATCHED
  REVIEW_REQUIRED
}

/// Entidade única de lançamento financeiro — cobre tanto receitas quanto
/// despesas (`type`). Mapeia para `FinanceEntry` (`@control-os/types`) na
/// borda do repositório (`PrismaFinanceRepository`) — nenhum tipo TS novo
/// duplicando `FinanceEntry` é criado por causa deste model.
model Transaction {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  type                   TransactionType
  origin                 TransactionOrigin @default(MANUAL)
  /// `Decimal`, não `Float` — dinheiro nunca deveria acumular erro de
  /// ponto flutuante binário. Convertido para `number` (formato de
  /// `FinanceEntry.amount`) na borda do repositório via `.toNumber()`.
  amount                 Decimal           @db.Decimal(12, 2)
  description            String?
  /// Rótulo livre (mesmo formato de `FinanceEntry.category`, `@control-os/types`)
  /// — o que esta fase de fato usa. Coexiste com `categoryId`/`categoryRef`
  /// abaixo de propósito: "expand-and-contract" — quando `Category` ganhar
  /// CRUD real (fase futura), a migração vira só passar a preencher
  /// `categoryId` também, sem quebrar nada que já lê `category` (string).
  category               String?
  date                   DateTime          @default(now()) @db.Timestamptz(3)
  status                 TransactionStatus @default(CONFIRMED)
  source                 TransactionSource @default(MANUAL)
  competenceDate         DateTime?         @map("competence_date") @db.Timestamptz(3)
  dueDate                DateTime?         @map("due_date") @db.Timestamptz(3)
  paidAt                 DateTime?         @map("paid_at") @db.Timestamptz(3)
  confirmedAt            DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  canceledAt             DateTime?         @map("canceled_at") @db.Timestamptz(3)
  idempotencyKey         String?           @map("idempotency_key") @db.VarChar(120)
  idempotencyFingerprint String?           @map("idempotency_fingerprint") @db.VarChar(128)
  correlationId          String?           @map("correlation_id") @db.Uuid
  reversalOfId           String?           @map("reversal_of_id") @db.Uuid
  reversalOf             Transaction?      @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversals              Transaction[]     @relation("TransactionReversal")

  categoryId  String?   @map("category_id") @db.Uuid
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  accountId String?  @map("account_id") @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id])

  /// CONTROL OS — Fase 7: guardava só a intenção ("preparado para
  /// recorrência futura"); agora `FinanceService.createRecurring` de fato
  /// escreve aqui o rótulo de frequência (`FinanceRecurrenceFrequency` —
  /// "mensal"/"semanal"/"anual"). Ainda "sem scheduler": nenhum job lê este
  /// campo para gerar novas `Transaction` automaticamente — só a primeira
  /// ocorrência é criada nesta fase.
  recurrenceRule String? @map("recurrence_rule")

  /// CONTROL OS — Fase 7: liga as DUAS pernas de uma mesma transferência
  /// (uma por conta). `transferDirection` diferencia qual perna é qual —
  /// ver doc do enum `TransferDirection` acima.
  transferGroupId   String?            @map("transfer_group_id") @db.Uuid
  transferDirection TransferDirection? @map("transfer_direction")

  /// CONTROL OS — Fase 7: liga todos os lançamentos de um mesmo
  /// parcelamento (ex.: as 12 parcelas de um notebook) — `installmentNumber`
  /// é 1-based, `installmentTotal` é o mesmo valor em todas as parcelas do
  /// grupo (redundante de propósito: evita um `COUNT` a mais só para saber
  /// "3 de quantas?").
  installmentGroupId String? @map("installment_group_id") @db.Uuid
  installmentNumber  Int?    @map("installment_number")
  installmentTotal   Int?    @map("installment_total")

  attachments                    Attachment[]
  fixedAccountOccurrencePayments FixedAccountOccurrencePayment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, type, date])
  @@index([userId, status, competenceDate])
  @@index([userId, idempotencyKey])
  @@index([reversalOfId])
  @@index([userId, accountId])
  @@index([transferGroupId])
  @@index([installmentGroupId])
  @@map("finance_transactions")
}

/// Categoria de lançamento (ex.: "Mercado", "Salário"). CONTROL OS — Fase 7:
/// `FinanceRepository.createCategory`/`listCategories` usam este model de
/// verdade agora (catálogo de categorias personalizadas do usuário,
/// somado às categorias padrão do sistema — que não são linhas desta
/// tabela, ver `DEFAULT_FINANCE_CATEGORIES`). `Transaction.categoryId` é a
/// referência persistente para o catálogo; `FinanceEntry.category` segue como
/// snapshot textual histórico, preservando relatórios após renomeações.
model Category {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  name                String
  kind                TransactionType?
  icon                String                   @default("tag") @db.VarChar(40)
  color               String                   @default("#6366F1") @db.VarChar(16)
  status              CategoryStatus           @default(ACTIVE)
  sortOrder           Int                      @default(0) @map("sort_order")
  isFavorite          Boolean                  @default(false) @map("is_favorite")
  archivedAt          DateTime?                @map("archived_at") @db.Timestamptz(3)
  transactions        Transaction[]
  fixedAccounts       FixedAccount[]
  occurrenceSnapshots FixedAccountOccurrence[]
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, status, isFavorite, sortOrder])
  @@map("finance_categories")
}

/// Conta financeira (ex.: "Carteira", "Nubank", "Cartão de Crédito").
/// CONTROL OS — Fase 7: sai do status de stub ("preparado, não usado") —
/// `FinanceRepository.createAccount`/`listAccounts` usam este model de
/// verdade agora. `@@unique([userId, name])`: evita duas
/// contas com o mesmo nome pro mesmo usuário (ex.: duas "Nubank" por engano
/// numa criação repetida via conversa) — seguro adicionar agora porque
/// nenhuma linha real existia antes desta fase (nada grava aqui ainda).
model Account {
  id                               String                   @id @default(uuid()) @db.Uuid
  userId                           String                   @map("user_id") @db.Uuid
  name                             String
  kind                             AccountKind              @default(OUTRO)
  currency                         String                   @default("BRL") @db.VarChar(3)
  status                           AccountStatus            @default(ACTIVE)
  archivedAt                       DateTime?                @map("archived_at") @db.Timestamptz(3)
  transactions                     Transaction[]
  fixedAccountsAsSource            FixedAccount[]           @relation("FixedAccountSource")
  fixedAccountsAsDestination       FixedAccount[]           @relation("FixedAccountDestination")
  occurrenceSnapshotsAsSource      FixedAccountOccurrence[] @relation("OccurrenceSourceAccount")
  occurrenceSnapshotsAsDestination FixedAccountOccurrence[] @relation("OccurrenceDestinationAccount")
  createdAt                        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, name])
  @@map("finance_accounts")
}

/// Cadastro permanente de uma obrigação/receita recorrente. Não carrega saldo
/// e não é uma transação: somente gera ocorrências com snapshot imutável.
model FixedAccount {
  id                      String                    @id @default(uuid()) @db.Uuid
  userId                  String                    @map("user_id") @db.Uuid
  name                    String
  description             String?
  type                    TransactionType
  origin                  FixedAccountOrigin        @default(PERSONAL)
  categoryId              String                    @map("category_id") @db.Uuid
  sourceAccountId         String?                   @map("source_account_id") @db.Uuid
  destinationAccountId    String?                   @map("destination_account_id") @db.Uuid
  paymentMethod           FixedAccountPaymentMethod @map("payment_method")
  amount                  Decimal                   @db.Decimal(12, 2)
  recurrence              FixedAccountRecurrence
  customIntervalDays      Int?                      @map("custom_interval_days")
  dueDay                  Int                       @map("due_day")
  startDate               DateTime                  @map("start_date") @db.Timestamptz(3)
  endDate                 DateTime?                 @map("end_date") @db.Timestamptz(3)
  active                  Boolean                   @default(true)
  archivedAt              DateTime?                 @map("archived_at") @db.Timestamptz(3)
  lastGeneratedCompetence String?                   @map("last_generated_competence") @db.VarChar(32)
  category                Category                  @relation(fields: [categoryId], references: [id])
  sourceAccount           Account?                  @relation("FixedAccountSource", fields: [sourceAccountId], references: [id])
  destinationAccount      Account?                  @relation("FixedAccountDestination", fields: [destinationAccountId], references: [id])
  occurrences             FixedAccountOccurrence[]
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, active, archivedAt])
  @@index([userId, lastGeneratedCompetence])
  @@index([categoryId])
  @@map("finance_fixed_accounts")
}

/// Fato mensal (ou semanal/anual) criado a partir de uma regra. Os campos da
/// regra são copiados para preservar fielmente a configuração daquele período.
model FixedAccountOccurrence {
  id                   String                            @id @default(uuid()) @db.Uuid
  fixedAccountId       String                            @map("fixed_account_id") @db.Uuid
  competenceMonth      Int                               @map("competence_month")
  competenceYear       Int                               @map("competence_year")
  referencePeriod      String                            @map("reference_period") @db.VarChar(32)
  dueDate              DateTime                          @map("due_date") @db.Timestamptz(3)
  name                 String
  description          String?
  type                 TransactionType
  origin               FixedAccountOrigin                @default(PERSONAL)
  categoryId           String                            @map("category_id") @db.Uuid
  paymentMethod        FixedAccountPaymentMethod         @map("payment_method")
  sourceAccountId      String?                           @map("source_account_id") @db.Uuid
  destinationAccountId String?                           @map("destination_account_id") @db.Uuid
  amount               Decimal                           @db.Decimal(12, 2)
  status               FixedAccountOccurrenceStatus      @default(PENDING)
  transactionId        String?                           @map("transaction_id") @db.Uuid
  paidAt               DateTime?                         @map("paid_at") @db.Timestamptz(3)
  reconciliationStatus FixedAccountReconciliationStatus? @map("reconciliation_status")
  externalReferenceId  String?                           @map("external_reference_id")
  fixedAccount         FixedAccount                      @relation(fields: [fixedAccountId], references: [id])
  category             Category                          @relation(fields: [categoryId], references: [id])
  sourceAccount        Account?                          @relation("OccurrenceSourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount   Account?                          @relation("OccurrenceDestinationAccount", fields: [destinationAccountId], references: [id])
  payments             FixedAccountOccurrencePayment[]
  createdAt            DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([fixedAccountId, referencePeriod])
  @@index([competenceYear, competenceMonth, dueDate])
  @@index([status, dueDate])
  @@map("finance_fixed_account_occurrences")
}

/// Cada baixa parcial é ligada a uma transação real. Isso elimina saldo
/// paralelo e permite que uma ocorrência seja concluída por várias baixas.
model FixedAccountOccurrencePayment {
  id            String                 @id @default(uuid()) @db.Uuid
  occurrenceId  String                 @map("occurrence_id") @db.Uuid
  transactionId String                 @unique @map("transaction_id") @db.Uuid
  amount        Decimal                @db.Decimal(12, 2)
  occurrence    FixedAccountOccurrence @relation(fields: [occurrenceId], references: [id])
  transaction   Transaction            @relation(fields: [transactionId], references: [id])
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([occurrenceId])
  @@map("finance_fixed_account_occurrence_payments")
}

/// Trilho genérico e extensível de auditoria do domínio financeiro. Não tem
/// dependência de telas ou canais: a mesma estrutura atende Manual, NOVA,
/// WhatsApp e API, preservando o estado anterior e posterior quando houver.
model FinanceAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  operation     String
  source        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  before        Json?    @map("before_state")
  after         Json?    @map("after_state")
  correlationId String?  @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("finance_audit_events")
}

/// Conta de produto do CONTROL OS. É separada da tabela histórica `users`
/// do serviço Python: o app web é dono deste modelo e usa o mesmo UUID como
/// escopo dos módulos financeiros.
model AppUser {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  whatsappLinks           WhatsAppLink[]
  verifications           WhatsAppVerification[]
  documents               StoredDocument[]
  documentImportProposals DocumentImportProposal[]
  conversationTasks       ConversationTask[]

  @@map("app_users")
}

/// Número do WhatsApp que já comprovou pertencer a uma conta. A unicidade
/// impede que um mesmo número seja vinculado a duas pessoas.
model WhatsAppLink {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  phoneE164  String   @unique @map("phone_e164")
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_links")
}

/// Desafio de confirmação iniciado no cadastro. O código nunca é guardado
/// em texto puro; a pessoa confirma mandando `VINCULAR 123456` pelo número
/// informado, o que comprova que controla aquele WhatsApp.
model WhatsAppVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  phoneE164 String   @unique @map("phone_e164")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_verifications")
}

/// Anexo de uma transação (ex.: foto de um recibo) — "preparar para
/// anexos, mesmo que ainda não implementados". `onDelete: Cascade`: um
/// anexo nunca deveria sobreviver à transação que ele documenta.
model Attachment {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("finance_attachments")
}

/// Arquivo privado do usuário. O conteúdo vive no Files API da OpenAI e
/// `openaiFileId` é usado exclusivamente pelo servidor para leitura e
/// download autenticado — nunca é exposto ao navegador como um segredo.
model StoredDocument {
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @map("user_id") @db.Uuid
  user                 AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  displayName          String?                  @map("display_name")
  originalFileName     String                   @map("original_file_name")
  mimeType             String                   @map("mime_type")
  detectedMimeType     String?                  @map("detected_mime_type")
  extension            String?
  sizeBytes            Int                      @map("size_bytes")
  sha256               String?
  storageProvider      DocumentStorageProvider? @map("storage_provider")
  storageStatus        DocumentStorageStatus    @default(MIGRATION_PENDING) @map("storage_status")
  storageKey           String?                  @unique @map("storage_key")
  scanStatus           DocumentScanStatus       @default(PENDING) @map("scan_status")
  scanDetails          Json?                    @map("scan_details")
  analysisStatus       DocumentAnalysisStatus   @default(NOT_REQUESTED) @map("analysis_status")
  analysisAttempts     Int                      @default(0) @map("analysis_attempts")
  analysisVersion      Int                      @default(1) @map("analysis_version")
  analysisStartedAt    DateTime?                @map("analysis_started_at") @db.Timestamptz(3)
  analysisCompletedAt  DateTime?                @map("analysis_completed_at") @db.Timestamptz(3)
  analysisErrorCode    String?                  @map("analysis_error_code")
  analysisErrorMessage String?                  @map("analysis_error_message")
  folder               String?
  tags                 String[]                 @default([])
  openaiFileId         String?                  @unique @map("openai_file_id")
  kind                 StoredDocumentKind       @default(GENERAL)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt           DateTime?                @map("archived_at") @db.Timestamptz(3)
  importProposals      DocumentImportProposal[]
  analysisJobs         DocumentAnalysisJob[]
  auditEvents          DocumentAuditEvent[]

  @@unique([userId, sha256])
  @@index([userId, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([analysisStatus, createdAt])
  @@map("stored_documents")
}

/// Dados extraídos de um contrato antes da confirmação. Mantém o texto
/// estruturado separado do domínio financeiro e guarda o vínculo para o
/// grupo de parcelas criado depois da aprovação do usuário.
model DocumentImportProposal {
  id                          String                       @id @default(uuid()) @db.Uuid
  userId                      String                       @map("user_id") @db.Uuid
  user                        AppUser                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId                  String                       @map("document_id") @db.Uuid
  document                    StoredDocument               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status                      DocumentImportProposalStatus @default(PENDING)
  extractedData               Json                         @map("extracted_data")
  analysisVersion             Int                          @default(1) @map("analysis_version")
  idempotencyKey              String?                      @unique @map("idempotency_key")
  validationWarnings          String[]                     @default([]) @map("validation_warnings")
  analysisErrorCode           String?                      @map("analysis_error_code")
  analysisErrorMessage        String?                      @map("analysis_error_message")
  expiresAt                   DateTime?                    @map("expires_at") @db.Timestamptz(3)
  resultingInstallmentGroupId String?                      @map("resulting_installment_group_id") @db.Uuid
  confirmedAt                 DateTime?                    @map("confirmed_at") @db.Timestamptz(3)
  rejectedAt                  DateTime?                    @map("rejected_at") @db.Timestamptz(3)
  discardedAt                 DateTime?                    @map("discarded_at") @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, status])
  @@index([documentId])
  @@map("document_import_proposals")
}

/// Fila persistente e idempotente. Um worker futuro pode consumi-la sem mudar
/// o contrato HTTP; enquanto isso um executor interno a processa sob demanda.
model DocumentAnalysisJob {
  id               String                    @id @default(uuid()) @db.Uuid
  documentId       String                    @map("document_id") @db.Uuid
  document         StoredDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  analysisVersion  Int                       @map("analysis_version")
  status           DocumentAnalysisJobStatus @default(QUEUED)
  /// Fase F — ver doc do enum `DocumentAnalysisProgressStage`. Escrito só
  /// pelo worker (`processNextDocumentAnalysisJob`), nunca pelo cliente;
  /// resetado para `READING_DOCUMENT` a cada nova tentativa/reenfileiramento.
  progressStage    DocumentAnalysisProgressStage @default(READING_DOCUMENT) @map("progress_stage")
  attempts         Int                       @default(0)
  runAfter         DateTime                  @default(now()) @map("run_after") @db.Timestamptz(3)
  lockedAt         DateTime?                 @map("locked_at") @db.Timestamptz(3)
  lockedBy         String?                   @map("locked_by")
  lastErrorCode    String?                   @map("last_error_code")
  lastErrorMessage String?                   @map("last_error_message")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([documentId, analysisVersion])
  @@index([status, runAfter])
  @@map("document_analysis_jobs")
}

/// Auditoria própria para arquivos e prévias. Não mistura eventos de domínio
/// documental com `FinanceAuditEvent`, que permanece dedicado ao financeiro.
model DocumentAuditEvent {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  documentId    String?         @map("document_id") @db.Uuid
  document      StoredDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  proposalId    String?         @map("proposal_id") @db.Uuid
  operation     String
  source        String
  entityType    String          @map("entity_type")
  entityId      String          @map("entity_id")
  correlationId String?         @map("correlation_id") @db.Uuid
  before        Json?
  after         Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([documentId, createdAt])
  @@index([correlationId])
  @@map("document_audit_events")
}

/// "Algo aconteceu e a NOVA precisa falar sobre isso com o usuário" —
/// fonte única de interações proativas da NOVA (evolução "NOVA como centro
/// da experiência"). Documento analisado (`DOCUMENT_ANALYSIS_COMPLETED`) é
/// o primeiro produtor; tipos futuros (email recebido, fatura vencida, PIX
/// recebido, conta atrasada, viagem próxima, meta atingida, evento de Open
/// Finance) reaproveitam esta MESMA tabela sem migration nova.
enum ConversationTaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_USER
  COMPLETED
  DISMISSED
  FAILED
}

enum ConversationTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// `type` e `sourceType` são `String`, não enum do Postgres: crescem sem
/// migration a cada produtor novo (validados por union type + switch
/// exaustivo em TypeScript, ver `services/conversation-tasks`). `status` e
/// `priority` continuam enum porque esse conjunto é estável e pequeno.
///
/// Sem foreign key formal para `sourceId`: o mesmo campo aponta para
/// tabelas diferentes dependendo de `sourceType` (hoje só
/// "document_import_proposal"). Handlers de resolução NUNCA decidem
/// dinheiro só com base no `payload` congelado aqui — sempre buscam de
/// novo o registro de origem atual antes de agir.
///
/// `idempotencyKey` é `@unique`: garante que o mesmo evento de origem
/// nunca cria duas tasks, mesmo sob retry (upsert na mesma transação que
/// grava a origem).
model ConversationTask {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  user           AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  status         ConversationTaskStatus   @default(PENDING)
  priority       ConversationTaskPriority @default(MEDIUM)
  title          String
  message        String
  payload        Json
  actions        Json
  sourceType     String                   @map("source_type")
  sourceId       String                   @map("source_id")
  idempotencyKey String                   @unique @map("idempotency_key")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt    DateTime?                @map("completed_at") @db.Timestamptz(3)
  dismissedAt    DateTime?                @map("dismissed_at") @db.Timestamptz(3)

  @@index([userId, status])
  @@index([sourceType, sourceId])
  @@map("conversation_tasks")
}
