# CONTROL OS — apps/api — variáveis de ambiente (Fase 1: estrutura apenas)

PROJECT_NAME="CONTROL OS API"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"

# PostgreSQL (database/docker-compose.yml usa estes mesmos valores)
POSTGRES_USER="control_os"
POSTGRES_PASSWORD="control_os_dev"
POSTGRES_DB="control_os"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql+psycopg2://control_os:control_os_dev@localhost:5432/control_os"

# Autenticação
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
ALGORITHM="HS256"

# CORS
CORS_ORIGINS="http://localhost:3000"

# IA (Fase 1: não integrado, apenas reservado)
OPENAI_API_KEY=""
