# CONTROL OS — Infraestrutura de produção — variáveis de ambiente
#
# Copie para ".env" nesta mesma pasta (infra/.env — NUNCA commitado) e
# preencha todos os valores antes de "docker compose up -d". Passo a passo
# completo: README.md desta pasta.
#
# Convenção: toda senha/segredo abaixo vem com o placeholder
# "CHANGE_ME_..." — o docker-compose.yml não tem nenhum valor padrão
# embutido para credenciais (só para flags não-sensíveis, ex.: AI_PROVIDER),
# de propósito: subir a stack sem preencher isto falha alto e rápido, em
# vez de silenciosamente usar uma senha fraca conhecida.

# =============================================================================
# DOMÍNIOS
# =============================================================================
# Todos precisam ter um registro DNS tipo A apontando para o IP público
# desta VPS ANTES de subir a stack — é assim que o desafio HTTP-01 do
# Let's Encrypt valida a posse do domínio (config real do Traefik é via
# env vars TRAEFIK_* no docker-compose.yml, serviço "traefik" — ver
# traefik/traefik.yml, mantido só como referência comentada).

# Domínio raiz do produto (usado só como referência/documentação e pela
# rota multi-tenant wildcard opcional — ver README, seção "Multi-tenant").
ROOT_DOMAIN=controlos.com.br

# CONTROL OS — app principal (Next.js)
DOMAIN_APP=app.controlos.com.br

# CONTROL OS — API (FastAPI)
DOMAIN_API=api.controlos.com.br

# Dashboard do Traefik (protegido por Basic Auth — ver TRAEFIK_DASHBOARD_*)
DOMAIN_TRAEFIK=traefik.controlos.com.br

# Evolution API (gateway do WhatsApp)
DOMAIN_EVOLUTION=evolution.controlos.com.br

# E-mail usado pelo Let's Encrypt (avisos de expiração, nunca exposto
# publicamente) — obrigatório para o ACME emitir certificado.
LETSENCRYPT_EMAIL=seu-email@dominio.com

# =============================================================================
# TRAEFIK DASHBOARD — Basic Auth
# =============================================================================
# NÃO preencha usuário/senha em texto puro aqui. Gere o hash com:
#   ./scripts/generate-dashboard-hash.sh usuario
# O script grava o resultado em traefik/dynamic/.htpasswd (arquivo já
# ignorado pelo git — ver .gitignore) — nada disso fica em variável de
# ambiente nem neste .env. Esta seção existe só para lembrar o passo;
# nenhuma variável abaixo é lida pelo docker-compose.yml.
#
# TRAEFIK_DASHBOARD_USER=admin   (referência apenas — informe ao rodar o script)

# --- DNS-01 (opcional, só para wildcard — ver README) -----------------------
# Necessário SÓ se você trocar o certResolver para DNS-01 nas variáveis
# TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_DNSCHALLENGE_* do
# docker-compose.yml (para emitir certificado wildcard *.{ROOT_DOMAIN}).
# Gerado no painel da Hostinger: hPanel → Avançado → API.
# HOSTINGER_API_TOKEN=CHANGE_ME_HOSTINGER_API_TOKEN

# =============================================================================
# POSTGRES — CONTROL OS (apps/web via Prisma, apps/api via SQLAlchemy)
# =============================================================================
POSTGRES_USER=controlos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=controlos

# Multi-tenant (opcional): lista separada por vírgula de bancos extras a
# provisionar na primeira inicialização do volume, além de POSTGRES_DB —
# ver postgres/init/01-init-multiple-databases.sh e README, seção
# "Multi-tenant". Deixe vazio para um único banco (comportamento padrão).
# Exemplo com dois tenants adicionais:
# POSTGRES_MULTIPLE_DATABASES=controlos_tenant_acme,controlos_tenant_beta
POSTGRES_MULTIPLE_DATABASES=

# =============================================================================
# REDIS — CONTROL OS (cache/sessão — provisionado, ver README)
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# SISTEMA — fuso horário e modo de execução
# =============================================================================
# IMPORTANTE: estas duas variáveis ainda NÃO são repassadas a nenhum
# serviço em docker-compose.yml (nenhum "environment: TZ: ${TZ}" ou
# "NODE_ENV: ${NODE_ENV}" existe lá hoje) — declarar aqui não muda o
# comportamento atual de nenhum container, de propósito (esta rodada de
# ajustes só tocou docker-compose.yml nos pontos explicitamente pedidos:
# versão da Evolution API, logging, limites de recursos, shm_size). Isto
# fica pronto para quando alguém decidir wire-ar:
#   - TZ: sem fuso explícito, containers rodam em UTC — relevante porque
#     data/hora relativa da NOVA ("amanhã às 15h", lembretes, agenda) é
#     pensada no fuso do usuário (Brasil), não em UTC.
#   - NODE_ENV=production: liga otimizações do Next.js (minificação,
#     remoção de código de dev). Nunca "development" num deploy real —
#     isso é só para ambiente local (pnpm dev).
TZ=America/Sao_Paulo
NODE_ENV=production

# =============================================================================
# WEB (apps/web — Next.js / NOVA)
# =============================================================================
# Espelha 1:1 apps/web/.env.local.example — ver aquele arquivo para a
# explicação completa de cada variável (client vs. server, NEXT_PUBLIC_*).

# "mock" (padrão, sem custo/nenhuma chave necessária) | "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_DEBUG_LOGS=0
AI_FALLBACK_TO_MOCK=0

# --- Futuras integrações de IA (reservado — NÃO usado pelo código hoje) -----
# Nenhuma destas três é lida por services/ai ou services/llm no estado
# atual do código (AI_PROVIDER só aceita "mock" | "openai" — ver
# services/ai/ai.config.ts). Os placeholders abaixo existem só para não
# exigir uma segunda rodada de configuração de infraestrutura quando um
# desses providers for implementado; preencher isto hoje não liga nada.
# ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
# ANTHROPIC_MODEL=claude-sonnet-5
# GOOGLE_AI_API_KEY=CHANGE_ME_GOOGLE_AI_API_KEY
# GOOGLE_AI_MODEL=gemini-2.5-pro
# OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
# OPENROUTER_MODEL=

# Decision Engine do CONTROL HUB (canais externos — WhatsApp via Evolution
# API, futuros). "mock" (padrão) | "openai".
DECISION_PROVIDER=mock
DECISION_ENGINE_DEBUG_LOGS=0

# =============================================================================
# API (apps/api — FastAPI)
# =============================================================================
API_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# EVOLUTION API — gateway do WhatsApp (serviço + Postgres + Redis próprios)
# =============================================================================
# Banco DEDICADO da Evolution — nunca o mesmo banco/instância do CONTROL OS
# (ver docker-compose.yml, rede "evolution-backend" isolada de "backend").
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
EVOLUTION_POSTGRES_DB=evolution

EVOLUTION_REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Chave global de autenticação da Evolution API — obrigatória para
# qualquer requisição à API (inclusive criar uma instância de WhatsApp).
# Gere um valor aleatório forte, ex.: `openssl rand -hex 32`.
EVOLUTION_API_KEY=CHANGE_ME_RANDOM_API_KEY

# Webhook global — a Evolution API chama esta URL a cada evento do
# WhatsApp. Desligado por padrão porque o endpoint HTTP que recebe isso no
# CONTROL OS ainda não existe (a Fase 8 entregou o Channel Gateway
# interno, não a rota HTTP pública — ver README, seção "Próximos passos").
# Quando essa rota existir, ligue e aponte para ela, ex.:
# EVOLUTION_WEBHOOK_ENABLED=true
# EVOLUTION_WEBHOOK_URL=https://${DOMAIN_APP}/api/whatsapp/webhook
EVOLUTION_WEBHOOK_ENABLED=false
EVOLUTION_WEBHOOK_URL=
