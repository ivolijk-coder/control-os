# Configuração de instalação para o pnpm neste monorepo.
#
# Causa raiz do ERR_PNPM_META_FETCH_FAIL / ERR_INVALID_THIS:
# Este repositório não possui pnpm-lock.yaml (decisão deliberada, ver README).
# Sem lockfile, todo `pnpm install` é uma resolução "fria": o pnpm precisa buscar
# o metadata de TODAS as dependências (diretas e transitivas) das 7 packages do
# workspace na registry do npm, em paralelo, a cada build. Esse volume alto de
# requisições concorrentes é o gatilho documentado de um bug conhecido de
# incompatibilidade entre o cliente de fetch do pnpm e o Node.js, que se manifesta
# como "ERR_INVALID_THIS: Value of \"this\" must be of type URLSearchParams" e
# derruba a resolução com ERR_PNPM_META_FETCH_FAIL.
#
# Reduzir a concorrência de rede evita o gatilho sem alterar versões, dependências
# ou arquitetura do projeto.
network-concurrency=1
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
