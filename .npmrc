# Configuração de instalação para o pnpm neste monorepo.
#
# Contexto histórico do ERR_PNPM_META_FETCH_FAIL / ERR_INVALID_THIS (ver README,
# seção "Deploy na Vercel"): quando este arquivo foi criado, o repositório AINDA
# não tinha `pnpm-lock.yaml` — todo `pnpm install` era uma resolução "fria", que
# buscava o metadata de todas as dependências (diretas e transitivas) das 7
# packages do workspace na registry do npm, em paralelo, a cada build. Esse
# volume alto de requisições concorrentes era o gatilho de um bug conhecido de
# incompatibilidade entre o cliente de fetch do pnpm e o Node.js
# ("ERR_INVALID_THIS: Value of \"this\" must be of type URLSearchParams").
#
# ATUALIZAÇÃO (Fase 7 — auditoria de produção): `pnpm-lock.yaml` agora EXISTE,
# está commitado na raiz do monorepo e é mantido atualizado a cada dependência
# nova. Com lockfile, `pnpm install` deixa de precisar resolver o grafo inteiro
# do zero — ele lê o lockfile e baixa os tarballs diretamente, o que já evita a
# maior parte do volume de requisições que disparava o bug original. As
# configurações abaixo são mantidas mesmo assim, como reforço de resiliência de
# rede (retries/concorrência) — não fazem mal e não dependem da presença ou
# ausência de lockfile.
network-concurrency=1
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
